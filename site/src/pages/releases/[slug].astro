---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReleaseDetail from '../../components/ReleaseDetail.astro';
import { copy } from '../../data/content';
import { releasesFor, slugOf } from '../../data/releases';

export async function getStaticPaths() {
  const releases = await releasesFor('en');
  return releases.map((entry) => ({ params: { slug: slugOf(entry) }, props: { entry } }));
}

const { entry } = Astro.props;
const t = copy.en;
// canonical は BaseLayout が Astro.url から作る。ここで組み立てない
const title = `${entry.data.version} — ${entry.data.title} | ${t.releases.detailSuffix}`;
---
<BaseLayout
  title={title}
  description={entry.data.summary}
  type="article"
  publishedTime={entry.data.date}
  modifiedTime={entry.data.updated ?? entry.data.date}
>
  <ReleaseDetail locale="en" entry={entry} />
</BaseLayout>
