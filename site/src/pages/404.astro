---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="404 — SEO Mastery Agent Skills"
  description="The page you asked for does not exist on seo.kpab.dev."
  noindex
>
  <div class="wrap notfound">
    <p class="label">404</p>
    <h1>Nothing at this path.</h1>
    <p>The page you asked for does not exist. <code>/</code> for English, <code>/ja</code> for 日本語.</p>
    <div class="hero__actions">
      <a class="btn btn--primary" href="/">Home</a>
      <a class="btn btn--ghost" href="/ja">日本語</a>
    </div>
  </div>
</BaseLayout>
