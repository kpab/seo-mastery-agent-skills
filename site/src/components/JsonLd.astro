---
interface Props { schema: Record<string, unknown> }
const { schema } = Astro.props;

/*
 * Astro は <script> の中身をエスケープしない。値に "</script>" が含まれると
 * そこでタグが閉じる。`<` を Unicode エスケープすれば JSON としても有効なまま防げる。
 */
const serialized = JSON.stringify(schema).replace(/</g, '\\u003c');
---
<script type="application/ld+json" is:inline set:html={serialized}></script>
