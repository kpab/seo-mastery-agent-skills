---
import JsonLd from './JsonLd.astro';
import { copy } from '../data/content';
import type { Locale } from '../data/site';
import { site } from '../data/site';
import { formatDate, releasePath, releasesFor, slugOf } from '../data/releases';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = copy[locale];
const releases = await releasesFor(locale);
// 非 null アサーションは TypeScript を黙らせるだけ。設定漏れは原因の分かる形で落とす
if (!Astro.site) throw new Error('astro.config.mjs に `site` がありません');
const base = Astro.site;
---
<section class="page-head">
  <div class="wrap">
    <p class="label">CHANGELOG</p>
    <h1>{t.releases.heading}</h1>
    <p class="page-head__lead">{t.releases.lead}</p>
    <p class="page-head__meta">
      <a href={`${site.repo}/blob/main/CHANGELOG.md`} rel="noopener">{t.releases.changelog}</a>
    </p>
  </div>
</section>

<section class="releases">
  <div class="wrap">
    <ol class="release-list">
      {releases.map((entry, i) => (
        <li class="release-item">
          <div class="release-item__meta">
            <span class="release-item__version">{entry.data.version}</span>
            {i === 0 && <span class="release-item__flag">{t.releases.latest}</span>}
            <time datetime={entry.data.date.toISOString().slice(0, 10)}>
              {formatDate(entry.data.date, locale)}
            </time>
          </div>
          <h2><a href={releasePath(locale, slugOf(entry))}>{entry.data.title}</a></h2>
          <p>{entry.data.summary}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<JsonLd
  schema={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: t.releases.metaTitle,
    description: t.releases.metaDescription,
    url: new URL(Astro.url.pathname, base).href,
    inLanguage: locale === 'ja' ? 'ja-JP' : 'en-US',
    isPartOf: { '@id': `${site.origin}/#website` },
    mainEntity: {
      '@type': 'ItemList',
      itemListOrder: 'https://schema.org/ItemListOrderDescending',
      numberOfItems: releases.length,
      itemListElement: releases.map((entry, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: `${entry.data.version} — ${entry.data.title}`,
        url: new URL(releasePath(locale, slugOf(entry)), base).href,
      })),
    },
  }}
/>
