---
import JsonLd from './JsonLd.astro';
import { copy } from '../data/content';
import type { Locale } from '../data/site';
import { site } from '../data/site';
import { formatDate, releaseIndexPath, releasePath, releasesFor, slugOf } from '../data/releases';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = copy[locale];
const home = locale === 'ja' ? '/ja' : '';
const [latest] = await releasesFor(locale);
const refFiles = [
  'technical-seo.md',
  'content-seo.md',
  'structured-data.md',
  'core-web-vitals.md',
  'ai-search.md',
  'astro-seo.md',
  'edge-seo.md',
  'audit-workflow.md',
];

// pre の中は JSX の空白整形に影響されるので、文字列として組み立てて set:html で流す
const c = (text: string) => `<span class="c">${text}</span>`;
const tree = [
  '.claude/skills/',
  `├── <b>seo-mastery/</b>            ${c(locale === 'ja' ? '# 英語版' : '# English')}`,
  `│   ├── SKILL.md              ${c(locale === 'ja' ? '# 振り分けと概要' : '# routing + overview')}`,
  ...refFiles.map((f, i) => `│   ${i === refFiles.length - 1 ? '└──' : '├──'} ${f}`),
  `└── <b>seo-mastery-jp/</b>         ${c(locale === 'ja' ? '# 日本語版（同じ 9 枚）' : '# Japanese (same nine files)')}`,
].join('\n');
---
<section class="hero">
  <div class="wrap hero__grid">
    <div class="hero__body">
      <p class="label">{t.hero.eyebrow}</p>
      <h1>{t.hero.heading}</h1>
      <p class="hero__lead">{t.hero.lead}</p>
      <div class="hero__actions">
        <a class="btn btn--primary" href={`${home}#install`}>{t.hero.primary}</a>
        <a class="btn btn--ghost" href={site.repo} rel="noopener">{t.hero.secondary}</a>
      </div>
      <ul class="hero__badges">
        {t.hero.badges.map((b) => <li>{b}</li>)}
      </ul>
    </div>

    <div class="term" aria-hidden="true">
      <div class="term__bar">
        <span class="term__dot"></span><span class="term__dot"></span><span class="term__dot"></span>
        <span class="term__title">claude</span>
      </div>
      <pre class="term__body"><span class="p">&gt;</span> {t.usage.prompts[2]}

<span class="c">Skill(seo-mastery)</span>
<span class="c">  └ audit-workflow.md, technical-seo.md</span>

<span class="out">✓</span> canonical  <span class="c">42/42 pages</span>
<span class="out">✓</span> sitemap    <span class="c">lastmod present</span>
<span class="c">!</span> hreflang   <span class="c">/ja missing x-default</span>
<span class="c">!</span> LCP        <span class="c">3.1s — hero image not preloaded</span></pre>
    </div>
  </div>
</section>

{latest && (
  <aside class="latest">
    <div class="wrap latest__inner">
      <span class="latest__flag">{t.releases.latest}</span>
      <a class="latest__link" href={releasePath(locale, slugOf(latest))}>
        <b>{latest.data.version}</b>{' — '}{latest.data.title}
      </a>
      <time class="latest__date" datetime={latest.data.date.toISOString().slice(0, 10)}>
        {formatDate(latest.data.date, locale)}
      </time>
      <a class="latest__all" href={releaseIndexPath(locale)}>{t.releases.all}</a>
    </div>
  </aside>
)}

<section id="why">
  <div class="wrap">
    <div class="section-head">
      <p class="label">{t.why.label}</p>
      <h2>{t.why.heading}</h2>
    </div>
    <ul class="cards cards--3">
      {t.why.items.map((item) => (
        <li class="card">
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<section id="coverage">
  <div class="wrap">
    <div class="section-head">
      <p class="label">{t.coverage.label}</p>
      <h2>{t.coverage.heading}</h2>
      <p>{t.coverage.lead}</p>
    </div>
    <ul class="refs">
      {t.coverage.items.map((item, i) => (
        <li class="ref">
          <h3>{item.title}{' '}<i>{refFiles[i]}</i></h3>
          <p>{item.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<section id="usage">
  <div class="wrap">
    <div class="section-head">
      <p class="label">{t.usage.label}</p>
      <h2>{t.usage.heading}</h2>
      <p>{t.usage.lead}</p>
    </div>
    <div class="usage__grid">
      <ul class="prompts">
        {t.usage.prompts.map((p) => <li>{p}</li>)}
      </ul>
      <p class="usage__reply">{t.usage.reply}</p>
    </div>
  </div>
</section>

<section id="install">
  <div class="wrap">
    <div class="section-head">
      <p class="label">{t.install.label}</p>
      <h2>{t.install.heading}</h2>
    </div>
    <ol class="steps">
      {t.install.steps.map((s, i) => (
        <li class="step">
          <p class="step__caption"><span class="step__n">{i + 1}</span>{s.caption}</p>
          <code>{s.cmd}</code>
        </li>
      ))}
    </ol>
    <p class="note">{t.install.note}</p>
    <div class="aside">
      <h3>{t.install.alt}</h3>
      <p>{t.install.altBody}</p>
    </div>
  </div>
</section>

<section id="files">
  <div class="wrap">
    <div class="section-head">
      <p class="label">{t.files.label}</p>
      <h2>{t.files.heading}</h2>
      <p>{t.files.lead}</p>
    </div>
    <pre class="tree" set:html={tree}></pre>
    <p class="note">{t.files.note}</p>
  </div>
</section>

<section id="freshness">
  <div class="wrap">
    <div class="section-head">
      <p class="label">{t.freshness.label}</p>
      <h2>{t.freshness.heading}</h2>
      <p>{t.freshness.lead}</p>
    </div>
    <ul class="cards cards--2">
      {t.freshness.items.map((item) => (
        <li class="card">
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<section id="faq">
  <div class="wrap">
    <div class="section-head">
      <p class="label">{t.faq.label}</p>
      <h2>{t.faq.heading}</h2>
    </div>
    <div class="faq">
      {t.faq.items.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <div>{item.a}</div>
        </details>
      ))}
    </div>
  </div>
</section>

<section class="cta">
  <div class="wrap cta__inner">
    <h2>{t.cta.heading}</h2>
    <p>{t.cta.body}</p>
    <div class="hero__actions">
      <a class="btn btn--primary" href={`${home}#install`}>{t.cta.primary}</a>
      <a class="btn btn--ghost" href={site.repo} rel="noopener">{t.cta.secondary}</a>
    </div>
  </div>
</section>

{/* FAQ リッチリザルトは 2026-05-07 に終了済み。意味付けとして残す */}
<JsonLd
  schema={{
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: locale === 'ja' ? 'ja-JP' : 'en-US',
    mainEntity: t.faq.items.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  }}
/>
