{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "seo-mastery-site",
  "compatibility_date": "2026-09-07",
  // 公開はカスタムドメインのみ。workers.dev とプレビュー URL は使わない
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "seo.kpab.dev", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    // /ja/ は /ja へ寄せる。canonical・サイトマップの末尾スラッシュなしと揃える
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
